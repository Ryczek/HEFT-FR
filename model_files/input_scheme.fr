(* Input scheme: optional replacements expressing internal EW/CKM building blocks
   in terms of user-chosen inputs (Gf, pole masses, ...) before Feynman rules. *)

(* Prefer explicit EWInputScheme from the notebook Configuration; else reuse legacy InputScheme. *)
If[ValueQ[Global`EWInputScheme], EWInputScheme = Global`EWInputScheme];
If[!ValueQ[EWInputScheme],
  EWInputScheme = If[ValueQ[InputScheme], InputScheme, "heft"]
];

EWInputScheme::invalid =
  "Unknown EWInputScheme `1`. Supported: \"heft\", \"gf\". Using no EW input replacement.";

(* ---------------------------------------------------------------------------
   "gf" and "aem" invert a muon-decay / gauge-mixing extraction derived to first order in the
   Wilson coefficients: every correction term below is linear in WCOrder and comes from P1,
   P12, PT, RL2 or RL5 (all chiral order 0).  That is exactly the model's own precision - a
   single EFT insertion per vertex, fixed since 2026-09-17 - so there is no order to check any
   more.  The former gate (HEFTEWInputSchemeCheckOrder, refusing EFTMaxOrder / MaxEFTInsertions
   above 1) went with the option.  Products of these shifts with any other coefficient are
   WCOrder^2 and are cut by HEFTTruncateOrders (HEFT_Model.fr): that is a documented
   limitation (README "Power counting and the single-insertion rule"), not an accident.
   --------------------------------------------------------------------------- *)

(* Symbolic identity in generation space (applied to LHEFT before FeynmanRules). *)
HEFTIdentityCKMRepl = {
  CKM[ff1_, ff2_] :> IndexDelta[ff1, ff2],
  Conjugate[CKM[ff1_, ff2_]] :> IndexDelta[ff1, ff2]
};

(* "heft": GW, G1 and vev are the inputs and the Lagrangian is left untouched (EWinputrepl =
   {}), but MZ and MW are PREDICTIONS (Internal, fields.fr / parameters_SM.fr, 2026-09-23).
   Their values are the Lagrangian's own mass terms, at first order in WCOrder:
     MZ^2 = (GW^2+G1^2) vev^2/4 + WCOrder vev^2/2 (-CPTn0 (GW^2+G1^2) + 2 CP12n0 GW^2
                                                    - 2 CP1n0 G1 GW),
   (CPTn0 enters with a minus since LPT has the paper's sign, 2026-09-24.)
     MW^2 = GW^2 vev^2/4   (no operator contributes).
   These are two-field terms, which FeynRules never turns into vertices
   (Core/VertexRoutine.m:630): before this, the declared MZ/MW were independent externals and
   the P1/P12/PT shifts of the Z mass never reached the propagator.  PT only rescales the
   existing Z mass direction (gw W3 - g1 B), so it changes nothing in gauge_normalization.fr.
   The rules go into M$Parameters only (HEFTHeftMassRepl, applied below), NOT into
   EWinputrepl: the Lagrangian contains neither MZ nor MW, and "heft" leaves it alone. *)
HEFTHeftMassRules[] :=
  Module[{c1, c12, cT},
    c1  = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["P1"],  CP1n0,  0];
    c12 = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["P12"], CP12n0, 0];
    cT  = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["PT"],  CPTn0,  0];
    {
      MZ -> vev/2*Sqrt[GW^2 + G1^2]*
              (1 + WCOrder*(-cT + 2*(c12*GW^2 - c1*G1*GW)/(GW^2 + G1^2))),
      MW -> GW*vev/2
    }
  ];
HEFTHeftMassRepl = {};

Switch[EWInputScheme,
  "heft",
  EWinputrepl = {};
  HEFTHeftMassRepl = HEFTHeftMassRules[],
  "gf",
  (* Tree-level relations plus the linear (single-insertion) shift from the muon-decay
     extraction of Gf, via
     the RL2/RL5 4-lepton contact operators (e-mu charged current,
     flavor slice [1,2,2,1]) and the P1/P12/PT gauge-mixing operators;
     each term carries exactly the bookkeeping factors its operator carries in
     the Lagrangian - WCOrder, all five having chiral order 0 - so HEFTTruncateOrders
     re-truncates them.

     Each NLO coefficient is gated on its operator being in the configured
     active piece list (HEFTActiveEFTPieces), mirroring the
     P12norm/eps pattern in gauge_normalization.fr: an operator that was
     not selected contributes 0 here, exactly as it contributes nothing to
     LEFTBosonic/LEFT4F. CPTn0 is PT's (formerly CFTn0, switched by IncludeCustodialT).
     Every CPTn0 term here (and in "aem" and the "heft" MZ rule) changed sign on 2026-09-24, when
     LPT took the paper's sign: the relations are linear in CPTn0 and were extracted from LPT. *)
  (* CRL2n0 / CRL5n0 (earlier CL2NLOn0 / CL5NLOn0, and before 2026-08-06 CL2NLOn0RE / CL5NLOn0RE): every
     fermionic Wilson coefficient is a real flavour tensor named C<op>n<n>, living in the
     flare function.  The n = 0 entry is the one the muon-decay extraction needs. *)
  HEFTGfCL2aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["RL2"],
    CRL2n0[1, 2, 2, 1], 0];
  HEFTGfCL5aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["RL5"],
    CRL5n0[1, 2, 2, 1], 0];
  HEFTGfCP1aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["P1"],
    CP1n0, 0];
  HEFTGfCP12aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["P12"],
    CP12n0, 0];
  HEFTGfCPTaux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["PT"],
    CPTn0, 0];

  (* The muon-decay extraction is a linear system in the two unknowns GW and G1, so the
     solution is linear in the four NLO coefficients.  The two combinations that appear
     are S0 = GW^2 + G1^2 and D0 = GW^2 - G1^2, which are declared Internal parameters in
     parameters/parameters_SM.fr. *)

  EWinputrepl = {
      vev -> 1/(2^(1/4)*Sqrt[Gf]) +
        8*2^(1/4)*WCOrder*Pi^2*
          (HEFTGfCL2aux - HEFTGfCL5aux)/(Gf^(3/2)*LamHEFT^2),
      GW -> 2^(5/4)*Sqrt[Gf]*MW +
        16*2^(3/4)*WCOrder*MW*Pi^2*
          (HEFTGfCL5aux - HEFTGfCL2aux)/(Sqrt[Gf]*LamHEFT^2),
      G1 -> 2^(5/4)*Sqrt[Gf]*Sqrt[MZ^2 - MW^2]
          - 4*2^(1/4)*HEFTGfCP12aux*WCOrder*Sqrt[Gf]*MW^2/Sqrt[MZ^2 - MW^2]
          + 2^(5/4)*HEFTGfCPTaux*WCOrder*Sqrt[Gf]*MZ^2/Sqrt[MZ^2 - MW^2]
          + 4*2^(1/4)*HEFTGfCP1aux*WCOrder*Sqrt[Gf]*MW
          + 16*2^(3/4)*WCOrder*Pi^2*
            (HEFTGfCL5aux - HEFTGfCL2aux)*Sqrt[MZ^2 - MW^2]/(Sqrt[Gf]*LamHEFT^2),
      GS -> Sqrt[4 Pi aS],
      hlambda -> Gf*MH^2/Sqrt[2] +
        16*WCOrder*MH^2*Pi^2*
          (HEFTGfCL5aux - HEFTGfCL2aux)/LamHEFT^2
    },
  "aem",
  HEFTaemCL2aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["RL2"],
    CRL2n0[1, 2, 2, 1], 0];
  HEFTaemCL5aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["RL5"],
    CRL5n0[1, 2, 2, 1], 0];
  HEFTaemCP1aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["P1"],
    CP1n0, 0];
  HEFTaemCP12aux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["P12"],
    CP12n0, 0];
  HEFTaemCPTaux = If[ValueQ[HEFTActiveEFTPieces] && HEFTPieceActiveQ["PT"],
    CPTn0, 0];


  (* Inputs: alpha_EM (as aEWM = alpha_EM itself), Gf, MZ, MH (+ aS).
     MW is NOT an input here - it is a PREDICTION, MW = GW vev/2, declared Internal in
     parameters/parameters_SM.fr and Mass -> {MW, Internal} in fields.fr, exactly the way
     FeynRules' own SM.fr does it in its alpha-scheme.

     vev and hlambda come from Gf and MH exactly as in "gf" above - the muon-decay
     extraction is the same.  What differs is GW and G1: with MW no longer measured,
     BOTH conditions are needed,

       (gW^2+gP^2) vev^2/4 (1 + chi M) == MZ^2        [Z pole mass]
       gW^2 gP^2/(gW^2+gP^2) (1 + chi E) == 4 Pi aEWM   [electric charge]

     At LO these make GW^2 and G1^2 the two roots of  x^2 - S0 x + 4 Pi aEWM S0 = 0 with
     S0 = 4 Sqrt[2] Gf MZ^2, i.e.

       GW = 2^(3/4) Sqrt[Gf MZ^2 + MZ RAD]      RAD = Sqrt[Gf^2 MZ^2 - 2 Sqrt[2] aEWM Gf Pi]
       G1 = 2^(3/4) Sqrt[Gf MZ^2 - MZ RAD]

     GW is the PLUS root: it is the LARGER coupling (SU(2), ~0.648 at PDG inputs, and it must
     satisfy MW = GW vev/2 = 80 GeV), G1 the MINUS root (~0.358).  Getting this the wrong way
     round is silent - both roots satisfy the two conditions, which are symmetric under
     GW <-> G1 - so it shows up only downstream, in MW.

     Written out fully in the inputs, gf-style: no auxiliary A/B/dvev variables and no
     HEFTaemS0/HEFTaemD0/HEFTgWSM/HEFTgPSM symbols, so every rule below is a closed form in
     Gf, MZ, aEWM, MH, aS alone.  The NLO shifts are the linearised solution of the same 2x2
     system, one additive term per Wilson coefficient, each gated on its operator exactly as
     in "gf".  Note RAD is repeated rather than named - that is the cost of keeping the rules
     self-contained, and it is deliberate.

     COST, measured and known: inlining the nested radical puts it at every occurrence of GW
     and G1 in the Lagrangian, where it must then survive HEFTTruncateOrders's Series
     expansion.  The declared-symbol version was measured at LeafCount 35963 / 129 s against
     171861 / 736 s for the inlined one, same configuration.  This file now takes the second
     option by choice; see TESTS.md T15 for the current number. *)
  EWinputrepl = {
      vev -> 1/(2^(1/4)*Sqrt[Gf])
        + 8*2^(1/4)*WCOrder*Pi^2*
            (HEFTaemCL2aux - HEFTaemCL5aux)/(Gf^(3/2)*LamHEFT^2),

      GW -> 2^(3/4)*Sqrt[Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]
        + HEFTaemCPTaux*WCOrder*
            Sqrt[Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]*
            (1 + Gf*MZ/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/2^(1/4)
        - 2^(7/4)*HEFTaemCP12aux*WCOrder*
            Sqrt[Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]
        + 2^(7/4)*HEFTaemCP1aux*WCOrder*
            Sqrt[Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]*
            Sqrt[Pi*aEWM*Gf/Sqrt[2]]/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]
        - 4*2^(5/4)*WCOrder*Pi^2*(HEFTaemCL2aux - HEFTaemCL5aux)*
            Sqrt[Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]*
            (1 + Gf*MZ/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(Gf*LamHEFT^2),
      
      G1 -> 2^(3/4)*Sqrt[Gf*MZ^2 - MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]
        + HEFTaemCPTaux*WCOrder*
            Sqrt[Gf*MZ^2 - MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]*
            (1 - Gf*MZ/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/2^(1/4)
        - 2^(7/4)*HEFTaemCP1aux*WCOrder*
            Sqrt[Gf*MZ^2 - MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]*
            Sqrt[Pi*aEWM*Gf/Sqrt[2]]/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]
        - 4*2^(5/4)*WCOrder*Pi^2*(HEFTaemCL2aux - HEFTaemCL5aux)*
            Sqrt[Gf*MZ^2 - MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]]*
            (1 - Gf*MZ/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(Gf*LamHEFT^2),
      MW -> Sqrt[(Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(2*Gf)]
        + HEFTaemCPTaux*WCOrder*
            Sqrt[(Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(2*Gf)]*
            (1 + Gf*MZ/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/2
        - 2*HEFTaemCP12aux*WCOrder*
            Sqrt[(Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(2*Gf)]
        + 2*HEFTaemCP1aux*WCOrder*
            Sqrt[(Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(2*Gf)]*
            Sqrt[Pi*aEWM*Gf/Sqrt[2]]/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi]
        + 4*Sqrt[2]*WCOrder*Pi^2*(HEFTaemCL2aux - HEFTaemCL5aux)*
            Sqrt[(Gf*MZ^2 + MZ*Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(2*Gf)]*
            (1 - Gf*MZ/Sqrt[Gf^2*MZ^2 - 2*Sqrt[2]*aEWM*Gf*Pi])/(Gf*LamHEFT^2),
            
      GS -> Sqrt[4 Pi aS],
      hlambda -> Gf*MH^2/Sqrt[2] +
        16*WCOrder*MH^2*Pi^2*
          (HEFTaemCL5aux - HEFTaemCL2aux)/LamHEFT^2
    },

  _,
  (* Falls back to "heft", as fields.fr and parameters_SM.fr do - so MZ/MW are Internal here
     too and need their values. *)
  (Message[EWInputScheme::invalid, EWInputScheme]; EWinputrepl = {};
   HEFTHeftMassRepl = HEFTHeftMassRules[])
];

(* ---------------------------------------------------------------------------
   SINGLE SOURCE for the derived EW parameters: EWinputrepl is written into M$Parameters.

   The rules above are applied to the LAGRANGIAN (HEFT_Model.fr, end of LHEFTMassBasis).
   M$Parameters is a separate object that substitution never touches, so parameters/parameters_SM.fr
   had to restate the same relations as Value -> ... for the parameter card: two encodings of
   one physics relation, free to drift apart.  They did - the "gf" G1 coefficients were wrong
   for two days (README SS "Input scheme (EW)", fixed 2026-08-12).

   Drift was not the worst of it: the two were not even used for the same thing.  The declared
   Value carries only the TREE-LEVEL relation, and it is what FeynRules resolves through
   MR$Definitions at vertex extraction - which runs AFTER LHEFTMassBasis, so every Definition
   mentioning one of these symbols escaped the input scheme completely.  The Yukawas are
   exactly that: yu/yd/yl and yuH/ydH/ylH are all Sqrt[2] M<f>/vev (parameters_SM.fr), keyed on
   NUMERIC generation indices, so they cannot fire during the
   ExpandIndices[..., FlavorExpand -> {SU2W, SU2D}] inside HEFTLHEFTMassBasisRaw (Generation is
   never expanded) and resolve only at export.  LYukawa is
   -vev/Sqrt[2] (yu + yuH H/vev + ...): the prefactor vev IS replaced by the scheme, the vev
   inside yu is NOT, so the two stopped cancelling and the fermion mass term came out as
   -M<f> (1 + WCOrder dvev) against a propagator mass of M<f> - the same class of bug as
   the Kappa/mass one fixed 2026-08-06.  Latent rather than visible: dvev is non-zero only with
   RL2 or RL5 active, they being the sole source of the vev shift in both schemes.

   Patching M$Parameters from EWinputrepl fixes both at once - the parameter card, the
   Lagrangian-level replacement, and everything MR$Definitions resolves later are one
   expression by construction.

   This has to happen HERE.  parameters_SM.fr is loaded before parameters_EFT.fr, so the Wilson
   coefficients the NLO shift needs do not exist yet there; this file is loaded last
   (HEFT_Model.fr) but still while the model files are being READ, i.e. before FeynRules
   processes M$Parameters.

   Two consequences - true of "aem"'s MW since 2026-08-12, now true of the whole set:
     - the exported values depend on the Wilson coefficients, so at their default of 1 they
       carry an unsuppressed O(1) NLO shift (that is what an O(1) coefficient means, not a bug);
     - with RL2/RL5 active the shift carries CRL2n0[1,2,2,1] / CRL5n0[1,2,2,1], i.e.
       INDEXED external parameters inside an Internal value, which runs into the open
       indexed-parameter WriteUFO bug (TODO.md, HIGH).  With those two inactive - the usual
       case - only scalar parameters appear and the export is clean.

   parameters/parameters_SM.fr keeps the DECLARATION (ParameterType, InteractionOrder, TeX,
   Description) and a tree-level Value.  For "gf"/"aem" that Value is superseded here; for
   "heft" EWinputrepl is empty and the five stay External as declared; only MZ and MW are
   patched there, from HEFTHeftMassRepl (see the Switch above).
   --------------------------------------------------------------------------- *)

HEFTEWInputPatch::missing =
  "EWInputScheme \"`1`\": EWinputrepl carries a rule for `2`, but M$Parameters has no entry \
for it - its exported value is therefore NOT the one the Lagrangian uses.";

(* Set Value -> ... in sym's M$Parameters entry, inserting it if the declaration has none.
   For "gf"/"aem" the declarations in parameters/parameters_SM.fr deliberately carry NO Value - the
   scheme is the only place a value comes from - so insertion is the normal path there, not a
   fallback.  Returns True if an entry was found, so a rule that patches nothing is reported
   rather than lost. *)
HEFTPatchParameterValue[sym_, val_] :=
  Module[{found = False},
    M$Parameters = M$Parameters /.
      HoldPattern[sym == opts_List] :> (
        found = True;
        sym == If[Cases[opts, HoldPattern[Value -> _]] === {},
          Append[opts, Value -> val],
          opts /. HoldPattern[Value -> _] :> (Value -> val)]
      );
    found
  ];

HEFTApplyEWInputToParameters[repl_List] :=
  Scan[
    Function[rule,
      If[!HEFTPatchParameterValue[First[rule], Last[rule]],
        Message[HEFTEWInputPatch::missing, EWInputScheme, First[rule]]
      ]
    ],
    repl
  ];

If[EWinputrepl =!= {}, HEFTApplyEWInputToParameters[EWinputrepl]];
If[HEFTHeftMassRepl =!= {}, HEFTApplyEWInputToParameters[HEFTHeftMassRepl]];

(* Nothing may be left un-valued.  Since the derived parameters are declared without a Value,
   a rule that failed to land would otherwise ship an Internal parameter FeynRules cannot
   evaluate - so fail here, loudly, instead of downstream.  Internal parameters that carry
   Definitions instead of a Value (AZnorm, gw, g1, gs, muH, ...) are legitimate and skipped. *)
HEFTEWInputPatch::novalue =
  "EWInputScheme \"`1`\": Internal parameter(s) `2` have neither Value nor Definitions after \
the input-scheme patch. parameters/parameters_SM.fr declares the derived parameters without a Value \
on purpose; every one of them must be covered by a rule in EWinputrepl.";

Module[{unvalued},
  unvalued = Cases[M$Parameters,
    HoldPattern[s_ == o_List] /;
      (MemberQ[o, HoldPattern[ParameterType -> Internal]] &&
       Cases[o, HoldPattern[Value -> _]] === {} &&
       Cases[o, HoldPattern[Definitions -> _]] === {}) :> s];
  If[unvalued =!= {},
    Message[HEFTEWInputPatch::novalue, EWInputScheme, unvalued];
    Abort[]
  ]
];

(* The CKM treatment is decided by DiagonalCKM alone (the CKMInputScheme option was removed on
   2026-08-06 - its "massless"/"identity" values did exactly what DiagonalCKM = True already
   does, and "full"/"none" were both no-ops here).  Default: the Wolfenstein CKM stays in
   M$Parameters and no replacement touches the Lagrangian.  DiagonalCKM = True (Configuration):
   CKM -> IndexDelta symbolically here; the .rst additionally zeros the Wolfenstein inputs for
   the parameter cards.  A genuine CKM *input scheme* (extraction from chosen inputs, on the
   footing EWInputScheme has) is not implemented - see README SS "Deferred configuration
   options". *)
CKMinputrepl = If[TrueQ[DiagonalCKM], HEFTIdentityCKMRepl, {}];

(* Keep EW and CKM replacements separate so they can be applied independently. *)
HEFTEWInputRepl = EWinputrepl;
HEFTCKMInputRepl = CKMinputrepl;

(* Backward-compatible combined list. *)
HEFTInputRepl = Join[HEFTEWInputRepl, HEFTCKMInputRepl];
