    aux = ExpandIndices[Sum[(LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
    (uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] + dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4])*
