(*4-fermion operators*)

LRQ1NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
  aux = ExpandIndices[(Sum[(QLbar[sp1, ii, ff1, cc].uR[sp1, ff2, cc])UFerm[ii, 1],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, cc].uR[sp2, ff4, cc]) UFerm[jj, 1],{jj, 1, 2}]
    +Sum[(QLbar[sp1, ii, ff1, cc].uR[sp1, ff2, cc])UFerm[ii, 1],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, cc].dR[sp2, ff4, cc]) UFerm[jj, 2],{jj, 1, 2}]
    +Sum[(QLbar[sp1, ii, ff1, cc].dR[sp1, ff2, cc])UFerm[ii, 2],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, cc].dR[sp2, ff4, cc]) UFerm[jj, 2],{jj, 1, 2}]
    +Sum[(QLbar[sp1, ii, ff1, cc].dR[sp1, ff2, cc])UFerm[ii, 2],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, cc].uR[sp2, ff4, cc]) UFerm[jj, 1],{jj, 1, 2}])
    *FCRQ1NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ2NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aa, aux},
  aux = ExpandIndices[
Sum[
    (Sum[(QLbar[sp1, ii, ff1, cc] . uR[sp1, ff2, cc]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc] . uR[sp2, ff4, cc]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp1, ii, ff1, cc] . dR[sp1, ff2, cc]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc] . dR[sp2, ff4, cc]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp1, ii, ff1, cc] . uR[sp1, ff2, cc]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc] . dR[sp2, ff4, cc]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp1, ii, ff1, cc] . dR[sp1, ff2, cc]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc] . uR[sp2, ff4, cc]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
   ,{aa,1,3}]
   *FCRQ2NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ3NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
  aux = ExpandIndices[(Sum[(QLbar[sp1, ii, ff1, cc].uR[sp1, ff2, cc])UFerm[ii, 1],{ii, 1, 2}])*
    ((Sum[(QLbar[sp2, kk, ff3, cc].uR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp2, kk, ff3, cc].dR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp2, kk, ff3, cc].dR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp2, kk, ff3, cc].uR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}]))
    *FCRQ3NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];


LRQ4NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
  aux = ExpandIndices[(Sum[(QLbar[sp1, ii, ff1, cc].uR[sp1, ff2, cc]) TTFerm[ii, jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc].uR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp1, ii, ff1, cc].uR[sp1, ff2, cc]) TTFerm[ii, jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc].dR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp1, ii, ff1, cc].dR[sp1, ff2, cc]) TTFerm[ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc].dR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp1, ii, ff1, cc].dR[sp1, ff2, cc]) TTFerm[ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
    (Sum[(QLbar[sp2, kk, ff3, cc].uR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    *FCRQ4NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ5NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, ii, jj, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[(Sum[(QLbar[sp1, ii, ff1, cc1].uR[sp1, ff2, cc2])UFerm[ii, 1],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, dd1].uR[sp2, ff4, dd2]) UFerm[jj, 1],{jj, 1, 2}]
    +Sum[(QLbar[sp1, ii, ff1, cc1].uR[sp1, ff2, cc2])UFerm[ii, 1],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, dd1].dR[sp2, ff4, dd2]) UFerm[jj, 2],{jj, 1, 2}]
    +Sum[(QLbar[sp1, ii, ff1, cc1].dR[sp1, ff2, cc2])UFerm[ii, 2],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, dd1].dR[sp2, ff4, dd2]) UFerm[jj, 2],{jj, 1, 2}]
    +Sum[(QLbar[sp1, ii, ff1, cc1].dR[sp1, ff2, cc2])UFerm[ii, 2],{ii, 1, 2}] Sum[(QLbar[sp2, jj, ff3, dd1].uR[sp2, ff4, dd2]) UFerm[jj, 1],{jj, 1, 2}])
    *T[aa,cc1,cc2]*T[aa,dd1,dd2]*FCRQ5NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ6NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[
Sum[
      (Sum[(QLbar[sp1, ii, ff1, cc1] . uR[sp1, ff2, cc2]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1] . uR[sp2, ff4, dd2]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1] . dR[sp1, ff2, cc2]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1] . dR[sp2, ff4, dd2]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1] . uR[sp1, ff2, cc2]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1] . dR[sp2, ff4, dd2]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1] . dR[sp1, ff2, cc2]) PauliSigmaFerm[aa,ii,jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1] . uR[sp2, ff4, dd2]) PauliSigmaFerm[aa,kk,ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
      ,{aa,1,3}
    ] * T[aa,cc1,cc2]*T[aa,dd1,dd2]*FCRQ6NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ7NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, cc1, cc2, dd1, dd2, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[(
      (Sum[(QLbar[sp1, ii, ff1, cc1].uR[sp1, ff2, cc2])UFerm[ii, 1],{ii, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].uR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1].uR[sp1, ff2, cc2])UFerm[ii, 1],{ii, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].dR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1].dR[sp1, ff2, cc2])UFerm[ii, 2],{ii, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].dR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1].dR[sp1, ff2, cc2])UFerm[ii, 2],{ii, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].uR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    )*T[aa,cc1,cc2]*T[aa,dd1,dd2]*FCRQ7NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ8NLO := Block[{sp1, sp2, si, ff1, ff2, ff3, ff4, cc1, cc2, dd1, dd2, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[(
      (Sum[(QLbar[sp1, ii, ff1, cc1].uR[sp1, ff2, cc2]) TTFerm[ii, jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].uR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1].uR[sp1, ff2, cc2]) TTFerm[ii, jj] UFerm[jj, 1], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].dR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1].dR[sp1, ff2, cc2]) TTFerm[ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].dR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
      +
      (Sum[(QLbar[sp1, ii, ff1, cc1].dR[sp1, ff2, cc2]) TTFerm[ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}]).
      (Sum[(QLbar[sp2, kk, ff3, dd1].uR[sp2, ff4, dd2]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    )*T[aa,cc1,cc2]*T[aa,dd1,dd2]*FCRQ8NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

(* R_1^{Q\ell}--R_6^{Q\ell}: mixed quark-lepton four-fermion (Brivio et al., arXiv:1604.06801). Same UFerm / TTFerm / PauliSigmaFerm pattern as LRQ1--LRQ8 but one QL chain replaced by LL-lR or LL-Q_R with colour on quarks contracted between the two bilinears where needed. *)

LRQL1NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(Sum[LLbar[sp1, ii, ff1].lR[sp1, ff2] UFerm[ii, 2], {ii, 1, 2}])*
    (Sum[(QLbar[sp2, jj, ff3, cc].uR[sp2, ff4, cc]) UFerm[jj, 1], {jj, 1, 2}]
     + Sum[(QLbar[sp2, jj, ff3, cc].dR[sp2, ff4, cc]) UFerm[jj, 2], {jj, 1, 2}])*
    FCRQL1NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQL2NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(Sum[(LLbar[sp1, ii, ff1].uR[sp1, ff4, cc]) UFerm[ii, 1], {ii, 1, 2}]
     + Sum[(LLbar[sp1, ii, ff1].dR[sp1, ff4, cc]) UFerm[ii, 2], {ii, 1, 2}])*
    (Sum[(QLbar[sp2, jj, ff3, cc].lR[sp2, ff2]) UFerm[jj, 2], {jj, 1, 2}])*
    FCRQL2NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQL3NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, cc, ii, kk, ll, aux},
    aux = ExpandIndices[(Sum[LLbar[sp1, ii, ff1].lR[sp1, ff2] UFerm[ii, 2], {ii, 1, 2}])*
    ((Sum[(QLbar[sp2, kk, ff3, cc].uR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp2, kk, ff3, cc].dR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp2, kk, ff3, cc].dR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}])
    +
    (Sum[(QLbar[sp2, kk, ff3, cc].uR[sp2, ff4, cc]) TTFerm[kk, ll] UFerm[ll, 1], {kk, 1, 2}, {ll, 1, 2}]))
    *FCRQL3NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQL4NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(Sum[(LLbar[sp1, ii, ff1].uR[sp1, ff4, cc]) TTFerm[ii, jj] UFerm[jj, 1]
    +(LLbar[sp1, ii, ff1].dR[sp1, ff4, cc]) TTFerm[ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}])*
    (Sum[(QLbar[sp2, kk, ff3, cc].lR[sp2, ff2]) UFerm[kk, 2], {kk, 1, 2}])
    *FCRQL4NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQL5NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[
Sum[
    (Sum[(LLbar[sp1, ii, ff1] . lR[sp1, ff2]) PauliSigmaFerm[aa, ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}])*
    (Sum[(QLbar[sp2, kk, ff3, cc] . uR[sp2, ff4, cc]) PauliSigmaFerm[aa, kk, ll] UFerm[ll, 1]
    +(QLbar[sp2, kk, ff3, cc] . dR[sp2, ff4, cc]) PauliSigmaFerm[aa, kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}]), {aa, 1, 3}]
    *FCRQL5NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];



LRQL6NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[
Sum[
    (Sum[(LLbar[sp1, ii, ff1] . uR[sp1, ff2, cc]) PauliSigmaFerm[aa, ii, jj] UFerm[jj, 1]
    +(LLbar[sp1, ii, ff1] . dR[sp1, ff2, cc]) PauliSigmaFerm[aa, ii, jj] UFerm[jj, 2], {ii, 1, 2}, {jj, 1, 2}])*
    (Sum[(QLbar[sp2, kk, ff3, cc] . lR[sp2, ff4]) PauliSigmaFerm[aa, kk, ll] UFerm[ll, 2], {kk, 1, 2}, {ll, 1, 2}]), {aa, 1, 3}]
    *FCRQL6NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];


(* R_7^{Q\ell}--R_23^{Q\ell}: mixed quark-lepton current-current operators (Brivio et al., arXiv:1604.06801). These mirror LRQ9--LRQ26 with one quark current replaced by a lepton current and colour carried only by quark lines. *)

LRQL7NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2])*
    (QLbar[sp3, jj, ff3, cc].QL[sp4, jj, ff4, cc] Ga[si, sp3, sp4])*
    FCRQL7NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRQL8NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, aux},
    aux = ExpandIndices[(lRbar[sp1, ff1].lR[sp2, ff2] Ga[si, sp1, sp2])*
    (uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] + dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4])*
    FCRQL8NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRQL9NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2])*
    Sum[(QLbar[sp3, kk, ff3, cc].QL[sp4, ll, ff4, cc] Ga[si, sp3, sp4] TTFerm[kk, ll]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQL9NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQL10NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, kk, ll, aux},
    aux = ExpandIndices[(lRbar[sp1, ff1].lR[sp2, ff2] Ga[si, sp1, sp2])*
    Sum[(uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQL10NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQL11NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, aux},
    aux = ExpandIndices[Sum[(LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
    (QLbar[sp3, kk, ff3, cc].QL[sp4, kk, ff4, cc] Ga[si, sp3, sp4])*
    FCRQL11NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQL12NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
    aux = ExpandIndices[Sum[(LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(QLbar[sp3, kk, ff3, cc].QL[sp4, ll, ff4, cc] Ga[si, sp3, sp4] TTFerm[kk, ll]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQL12NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQL13NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[
Sum[
      Sum[(LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] PauliSigmaFerm[aa, ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
      Sum[(QLbar[sp3, kk, ff3, cc].QL[sp4, ll, ff4, cc] Ga[si, sp3, sp4] PauliSigmaFerm[aa, kk, ll]), {kk, 1, 2}, {ll, 1, 2}],
      {aa, 1, 3}
    ]*FCRQL13NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQL14NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2])*
    (uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] + dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4])*
    FCRQL14NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

