LRQL22NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
    (lRbar[sp3, ff3].dR[sp4, ff4, cc] Ga[si, sp3, sp4])*
