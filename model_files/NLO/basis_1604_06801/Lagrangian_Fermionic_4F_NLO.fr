LRQ20NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc].QL[sp2, jj, ff2, cc] Ga[si, sp1, sp2] TTFerm[ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQ20NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ21NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[
Sum[
      Sum[(QLbar[sp1, ii, ff1, cc].QL[sp2, jj, ff2, cc] Ga[si, sp1, sp2] PauliSigmaFerm[aa,ii,jj]), {ii, 1, 2}, {jj, 1, 2}]*
      Sum[(uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa, kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}],
    {aa, 1, 3}]*
    FCRQ21NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ22NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc1].QL[sp2, ii, ff2, cc2] Ga[si, sp1, sp2])*
    (uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] + dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4]
    + uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] + dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4])*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ22NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRQ23NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc1].QL[sp2, ii, ff2, cc2] Ga[si, sp1, sp2])*
    Sum[(uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ23NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ24NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc1].QL[sp2, jj, ff2, cc2] TTFerm[ii, jj] Ga[si, sp1, sp2]), {ii, 1, 2}, {jj, 1, 2}]*
    (uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] + dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4]
    + uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] + dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4])*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ24NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];


LRQ25NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc1].QL[sp2, jj, ff2, cc2] TTFerm[ii, jj] Ga[si, sp1, sp2]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ25NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ26NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, mm, aa, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[
Sum[
      Sum[(QLbar[sp1, ii, ff1, cc1].QL[sp2, jj, ff2, cc2] Ga[si, sp1, sp2] PauliSigmaFerm[aa,ii,jj]), {ii, 1, 2}, {jj, 1, 2}]*
      Sum[(uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa, kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}],
    {aa, 1, 3}]*T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ26NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRL1NLO := Block[{sp1, sp2, ff1, ff2, ff3, ff4, i1, i2, aux},
    aux = Sum[LLbar[sp1, i1, ff1].lR[sp1, ff2] UFerm[i1, 2] , {i1, 1, 2}] *
    Sum[LLbar[sp2, i2, ff3].lR[sp2, ff4] UFerm[i2, 2], {i2, 1, 2}] *
    FCL1NLO[H, NEFT, ff1, ff2, ff3, ff4];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux + HC[aux]
];

LRL2NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2])*
    (LLbar[sp3, kk, ff3].LL[sp4, ll, ff4] Ga[si, sp3, sp4])*
    FCL2NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRL3NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, aux},
    aux = ExpandIndices[(lRbar[sp1, ff1].lR[sp2, ff2] Ga[si, sp1, sp2])*
    (lRbar[sp3, ff3].lR[sp4, ff4] Ga[si, sp3, sp4])*
    FCL3NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRL4NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2]) *
    (Sum[
      LLbar[sp3, kk, ff3].LL[sp4, ll, ff4] Ga[si, sp3, sp4] TTFerm[kk, ll],
      {kk, 1, 2}, {ll, 1, 2}]) *
    FCL4NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRL5NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(Sum[
      LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj],
      {ii, 1, 2}, {jj, 1, 2}
    ])*
    (Sum[
      LLbar[sp3, kk, ff3].LL[sp4, ll, ff4] Ga[si, sp3, sp4] TTFerm[kk, ll],
      {kk, 1, 2}, {ll, 1, 2}
    ])*
    FCL5NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRL6NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2])*
    (lRbar[sp3, ff3].lR[sp4, ff4] Ga[si, sp3, sp4])*
    FCL6NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRL7NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, aux},
    aux = ExpandIndices[(Sum[
        LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj],
      {ii, 1, 2}, {jj, 1, 2}
    ])*
    (lRbar[sp3, ff3].lR[sp4, ff4] Ga[si, sp3, sp4])*
    FCL7NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];


(* Assembly (eq. 2.22): (4 pi)^2/Lambda^2 for RQ1-8, RQL1-6, RL1;
   1/Lambda^2 for RQ9-26, RQL7-23, RL2-7. *)

LNLO4FermChiraux = 0;
If[HEFTPieceActiveQ[ "RQ1NLO"], LNLO4FermChiraux += LRQ1NLO];
If[HEFTPieceActiveQ[ "RQ2NLO"], LNLO4FermChiraux += LRQ2NLO];
