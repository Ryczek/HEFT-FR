LRQL23NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aa, aux},
    aux = ExpandIndices[
Sum[
      Sum[(QLbar[sp1, ii, ff1, cc].LL[sp2, jj, ff2] Ga[si, sp1, sp2] PauliSigmaFerm[aa,ii,jj]), {ii, 1, 2}, {jj, 1, 2}]*
      Sum[(lRbar[sp3, ff3].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa, kk,ll] UFerm[ll,1])
      +(lRbar[sp3, ff3].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2]), {kk, 1, 2}, {ll, 1, 2}],
      {aa, 1, 3}
    ]*FCRQL23NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

(* R_9^Q--R_26^Q: four-quark operators; Q_R = (uR, dR)^T. Goldstone matrix U enters via VUFerm (QL, gamma) and UFerm (Yukawa lines); RH (\bar Q_R \gamma Q_R) and U^\dag T U / U^\dag \sigma^aa U match LNQ2 / LNQ4 (Brivio et al., arXiv:1604.06801). *)

LRQ9NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc].QL[sp2, ii, ff2, cc] Ga[si, sp1, sp2])*
    (QLbar[sp3, jj, ff3, cc].QL[sp4, jj, ff4, cc] Ga[si, sp3, sp4])*
    FCRQ9NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRQ10NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, mm, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc].QL[sp2,  ii, ff2, cc] Ga[si, sp1, sp2])*
    Sum[(QLbar[sp3, kk, ff3, cc].QL[sp4, ll, ff4, cc] Ga[si, sp3, sp4] TTFerm[kk, ll]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQ10NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ11NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, mm, nn, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc].QL[sp2, jj, ff2, cc] Ga[si, sp1, sp2] TTFerm[ii, jj]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(QLbar[sp3, kk, ff3, cc].QL[sp4, ll, ff4, cc] Ga[si, sp3, sp4] TTFerm[kk, ll]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQ11NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];


LRQ12NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, mm, nn, aa, aux},
    aux = ExpandIndices[
Sum[
    Sum[(QLbar[sp1, ii, ff1, cc].QL[sp2, jj, ff2, cc] Ga[si, sp1, sp2] PauliSigmaFerm[aa,ii,jj]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(QLbar[sp3, kk, ff3, cc].QL[sp4, ll, ff4, cc] Ga[si, sp3, sp4] PauliSigmaFerm[aa,kk,ll]), {kk, 1, 2}, {ll, 1, 2}],
      {aa, 1, 3}
    ]*FCRQ12NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ13NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, aux},
    aux = ExpandIndices[(uRbar[sp1, ff1, cc].uR[sp2, ff2, cc] Ga[si, sp1, sp2] + dRbar[sp1, ff1, cc].dR[sp2, ff2, cc] Ga[si, sp1, sp2])*
    (uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] + dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4])*
    FCRQ13NLO[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux
];

LRQ14NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(uRbar[sp1, ff1, cc].uR[sp2, ff2, cc] Ga[si, sp1, sp2] + dRbar[sp1, ff1, cc].dR[sp2, ff2, cc] Ga[si, sp1, sp2])*
    Sum[(uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQ14NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ15NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, kk, ll, aux},
    aux = ExpandIndices[Sum[(uRbar[sp1, ff1, cc].uR[sp2, ff2, cc] Ga[si, sp1, sp2] HC[UFerm[1,ii]] TTFerm[ii,jj] UFerm[jj,1])
    +(uRbar[sp1, ff1, cc].dR[sp2, ff2, cc] Ga[si, sp1, sp2] HC[UFerm[1,ii]] TTFerm[ii,jj] UFerm[jj,2])
    +(dRbar[sp1, ff1, cc].dR[sp2, ff2, cc] Ga[si, sp1, sp2] HC[UFerm[2,ii]] TTFerm[ii,jj] UFerm[jj,2])
    +(dRbar[sp1, ff1, cc].uR[sp2, ff2, cc] Ga[si, sp1, sp2] HC[UFerm[2,ii]] TTFerm[ii,jj] UFerm[jj,1]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    FCRQ15NLO[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ16NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, aa,kk,ll, aux},
    aux = ExpandIndices[
Sum[
    (uRbar[sp1, ff1, cc].uR[sp2, ff2, cc] Ga[si, sp1, sp2] + dRbar[sp1, ff1, cc].dR[sp2, ff2, cc] Ga[si, sp1, sp2])*
    Sum[(uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa, kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}],
    {aa, 1, 3}]*FCRQ16NLO[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux
];

LRQ17NLO := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc].QL[sp2, ii, ff2, cc] Ga[si, sp1, sp2])*
    (uRbar[sp3, ff3, cc].uR[sp4, ff4, cc] Ga[si, sp3, sp4] + dRbar[sp3, ff3, cc].dR[sp4, ff4, cc] Ga[si, sp3, sp4])*
