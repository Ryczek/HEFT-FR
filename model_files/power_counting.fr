(* Power-counting parameters for HEFT (Brivio et al. 1604.06801).
   Expansion controls, set in the notebook Configuration and passed on by heft_fr.wl:
     (ChiralOrder is a label only - nothing is cut on it; WCOrder is always cut at WCOrder^1,
      one Wilson-coefficient insertion per vertex.  Neither is an option since 2026-09-17.)
     HiggsMaxOrder      — H/vev truncation for F-functions (internal NEFT)
   LamHEFT (Λ) is declared in parameters/parameters_SM.fr.
   LamGold (the Goldstone-matrix expansion parameter) was removed 2026-09-18 with the Rxi gauge
   branch: the model is unitary gauge only and there are no Goldstones to expand. *)

powerCountingParams = {
  (* ChiralOrder^n on every EFT term, n counted from its W/V/d/D content: 2 -> n = 0, 3 -> 1,
     4 -> 2 (e.g. PG, PW, P1, PT: 0; P2, S2, PWWW, PGGG: 1; PDH, P6: 2).  SM terms carry none. *)
  ChiralOrder == {
    ParameterType    -> External,
    BlockName        -> HEFT,
    Value            -> 1,
    InteractionOrder -> {ChiralOrder, 1},
    Description      -> "Chiral-order bookkeeper: ChiralOrder^n, n from the W/V/d/D count of the operator"
  },
  (* WCOrder counts Wilson-coefficient insertions and flags EVERY EFT parameter: each EFT
     operator carries exactly one power, and so do
     the Delta-framework deviations and the F-function (h/v tower) coefficients of the SM-like
     sector.  Kappa-framework rescalings multiply SM couplings and are deliberately not flagged.
     "Leading order" is ChiralOrder^0 and nothing else: P1, P12, PT, ... are chiral order 0 and
     still carry one WCOrder each, because WCOrder counts coefficient insertions, not orders. *)
  WCOrder == {
    ParameterType    -> External,
    BlockName        -> HEFT,
    Value            -> 1,
    InteractionOrder -> {WCOrder, 1},
    Description      -> "Wilson-coefficient order: one power per Wilson-coefficient insertion"
  },
  LamF == {
    ParameterType    -> External,
    BlockName        -> HEFTEXP,
    Value            -> 1,
    InteractionOrder -> {ExpansionF, 1},
    Description      -> "H/v form-factor expansion counting parameter (LamF)"
  }
};

(* Append power-counting parameters to the global parameter list. *)
If[ValueQ[M$Parameters],
  M$Parameters = Join[M$Parameters, powerCountingParams],
  M$Parameters = powerCountingParams
];

powercountingreplacements = {LamF -> 1};