(* R_9^Q--R_26^Q: four-quark operators; Q_R = (uR, dR)^T. The chiral matrix U (identity in unitary gauge) enters via VUFerm (QL, gamma) and UFerm (Yukawa lines); RH (\bar Q_R \gamma Q_R) and U^\dag T U / U^\dag \sigma^aa U match LNQ2 / LNQ4 (Brivio et al., arXiv:1604.06801). *)

LRQ9 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, cc, ii, jj, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc].QL[sp2, ii, ff2, cc] Ga[si, sp1, sp2])*
    (QLbar[sp3, jj, ff3, cc].QL[sp4, jj, ff4, cc] Ga[si, sp3, sp4])*
    FCRQ9[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
