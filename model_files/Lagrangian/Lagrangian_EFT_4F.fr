      Sum[(uRbar[sp3, ff3, cc2].uR[sp4, ff4, cc2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa, kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, cc2].dR[sp4, ff4, cc2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc2].dR[sp4, ff4, cc2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, cc2].uR[sp4, ff4, cc2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[aa,kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}],
    {aa, 1, 3}]*
    FCRQ21[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ22 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc1].QL[sp2, ii, ff2, cc2] Ga[si, sp1, sp2])*
    (uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] + dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4])*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ22[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ23 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[(QLbar[sp1, ii, ff1, cc1].QL[sp2, ii, ff2, cc2] Ga[si, sp1, sp2])*
    Sum[(uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ23[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ24 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc1].QL[sp2, jj, ff2, cc2] TTFerm[ii, jj] Ga[si, sp1, sp2]), {ii, 1, 2}, {jj, 1, 2}]*
    (uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] + dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4])*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ24[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];


LRQ25 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[Sum[(QLbar[sp1, ii, ff1, cc1].QL[sp2, jj, ff2, cc2] TTFerm[ii, jj] Ga[si, sp1, sp2]), {ii, 1, 2}, {jj, 1, 2}]*
    Sum[(uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] TTFerm[kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}]*
    T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ25[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRQ26 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, mm, ss, aa, cc1, cc2, dd1, dd2, aux},
    aux = ExpandIndices[
Sum[
      Sum[(QLbar[sp1, ii, ff1, cc1].QL[sp2, jj, ff2, cc2] Ga[si, sp1, sp2] PauliSigmaFerm[ss,ii,jj]), {ii, 1, 2}, {jj, 1, 2}]*
      Sum[(uRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[ss, kk,ll] UFerm[ll,1])
    +(uRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[1,kk]] PauliSigmaFerm[ss,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].dR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[ss,kk,ll] UFerm[ll,2])
    +(dRbar[sp3, ff3, dd1].uR[sp4, ff4, dd2] Ga[si, sp3, sp4] HC[UFerm[2,kk]] PauliSigmaFerm[ss,kk,ll] UFerm[ll,1]), {kk, 1, 2}, {ll, 1, 2}],
    {ss, 1, 3}]*T[aa, cc1, cc2]*T[aa, dd1, dd2]*FCRQ26[H, NEFT, ff1, ff2, ff3, ff4],
        FlavorExpand -> {SU2D}, NoDefinitions -> True];
      aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRL1 := Block[{sp1, sp2, ff1, ff2, ff3, ff4, i1, i2, aux},
    aux = Sum[LLbar[sp1, i1, ff1].lR[sp1, ff2] UFerm[i1, 2] , {i1, 1, 2}] *
    Sum[LLbar[sp2, i2, ff3].lR[sp2, ff4] UFerm[i2, 2], {i2, 1, 2}] *
    FCRL1[H, NEFT, ff1, ff2, ff3, ff4];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux + HC[aux]
];

LRL2 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2])*
    (LLbar[sp3, kk, ff3].LL[sp4, kk, ff4] Ga[si, sp3, sp4])*
    FCRL2[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRL3 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, aux},
    aux = ExpandIndices[(lRbar[sp1, ff1].lR[sp2, ff2] Ga[si, sp1, sp2])*
    (lRbar[sp3, ff3].lR[sp4, ff4] Ga[si, sp3, sp4])*
    FCRL3[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRL4 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2]) *
    (Sum[
      LLbar[sp3, kk, ff3].LL[sp4, ll, ff4] Ga[si, sp3, sp4] TTFerm[kk, ll],
      {kk, 1, 2}, {ll, 1, 2}]) *
    FCRL4[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRL5 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, kk, ll, aux},
    aux = ExpandIndices[(Sum[
      LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj],
      {ii, 1, 2}, {jj, 1, 2}
    ])*
    (Sum[
      LLbar[sp3, kk, ff3].LL[sp4, ll, ff4] Ga[si, sp3, sp4] TTFerm[kk, ll],
      {kk, 1, 2}, {ll, 1, 2}
    ])*
    FCRL5[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];

LRL6 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, aux},
    aux = ExpandIndices[(LLbar[sp1, ii, ff1].LL[sp2, ii, ff2] Ga[si, sp1, sp2])*
    (lRbar[sp3, ff3].lR[sp4, ff4] Ga[si, sp3, sp4])*
    FCRL6[H, NEFT, ff1, ff2, ff3, ff4], FlavorExpand -> {SU2D}, NoDefinitions -> True];
  aux + HC[aux]
];

LRL7 := Block[{sp1, sp2, sp3, sp4, si, ff1, ff2, ff3, ff4, ii, jj, aux},
    aux = ExpandIndices[(Sum[
        LLbar[sp1, ii, ff1].LL[sp2, jj, ff2] Ga[si, sp1, sp2] TTFerm[ii, jj],
      {ii, 1, 2}, {jj, 1, 2}
    ])*
    (lRbar[sp3, ff3].lR[sp4, ff4] Ga[si, sp3, sp4])*
    FCRL7[H, NEFT, ff1, ff2, ff3, ff4],
      FlavorExpand -> {SU2D}, NoDefinitions -> True];
    aux = ExpandIndices[aux, FlavorExpand -> {SU2W}, NoDefinitions -> True];
  aux + HC[aux]
];


(* Assembly (eq. 2.22): (4 pi)^2/Lambda^2 for every four-fermion operator, each with its + h.c. in its
   definition (as the paper's overall + h.c.).  The current-current RQ9-26, RQL7-23, RL2-7 got theirs
   2026-10-08: with independent real flavour tensors they were not Hermitian without it.  The two blocks
   (chirality-flipping / current-current) are kept for readability only. *)

LEFT4FChiraux = 0;
If[HEFTPieceActiveQ[ "RQ1"], LEFT4FChiraux += Hold[LRQ1]];
If[HEFTPieceActiveQ[ "RQ2"], LEFT4FChiraux += Hold[LRQ2]];
If[HEFTPieceActiveQ[ "RQ3"], LEFT4FChiraux += Hold[LRQ3]];
If[HEFTPieceActiveQ[ "RQ4"], LEFT4FChiraux += Hold[LRQ4]];
If[HEFTPieceActiveQ[ "RQ5"], LEFT4FChiraux += Hold[LRQ5]];
If[HEFTPieceActiveQ[ "RQ6"], LEFT4FChiraux += Hold[LRQ6]];
If[HEFTPieceActiveQ[ "RQ7"], LEFT4FChiraux += Hold[LRQ7]];
If[HEFTPieceActiveQ[ "RQ8"], LEFT4FChiraux += Hold[LRQ8]];
If[HEFTPieceActiveQ[ "RQL1"], LEFT4FChiraux += Hold[LRQL1]];
If[HEFTPieceActiveQ[ "RQL2"], LEFT4FChiraux += Hold[LRQL2]];
If[HEFTPieceActiveQ[ "RQL3"], LEFT4FChiraux += Hold[LRQL3]];
If[HEFTPieceActiveQ[ "RQL4"], LEFT4FChiraux += Hold[LRQL4]];
If[HEFTPieceActiveQ[ "RQL5"], LEFT4FChiraux += Hold[LRQL5]];
If[HEFTPieceActiveQ[ "RQL6"], LEFT4FChiraux += Hold[LRQL6]];
If[HEFTPieceActiveQ[ "RL1"], LEFT4FChiraux += Hold[LRL1]];

LEFT4FVecaux = 0;
If[HEFTPieceActiveQ[ "RQL7"], LEFT4FVecaux += Hold[LRQL7]];
If[HEFTPieceActiveQ[ "RQL8"], LEFT4FVecaux += Hold[LRQL8]];
If[HEFTPieceActiveQ[ "RQL9"], LEFT4FVecaux += Hold[LRQL9]];
If[HEFTPieceActiveQ[ "RQL10"], LEFT4FVecaux += Hold[LRQL10]];
If[HEFTPieceActiveQ[ "RQL11"], LEFT4FVecaux += Hold[LRQL11]];
If[HEFTPieceActiveQ[ "RQL12"], LEFT4FVecaux += Hold[LRQL12]];
If[HEFTPieceActiveQ[ "RQL13"], LEFT4FVecaux += Hold[LRQL13]];
If[HEFTPieceActiveQ[ "RQL14"], LEFT4FVecaux += Hold[LRQL14]];
If[HEFTPieceActiveQ[ "RQL15"], LEFT4FVecaux += Hold[LRQL15]];
If[HEFTPieceActiveQ[ "RQL16"], LEFT4FVecaux += Hold[LRQL16]];
If[HEFTPieceActiveQ[ "RQL17"], LEFT4FVecaux += Hold[LRQL17]];
If[HEFTPieceActiveQ[ "RQL18"], LEFT4FVecaux += Hold[LRQL18]];
If[HEFTPieceActiveQ[ "RQL19"], LEFT4FVecaux += Hold[LRQL19]];
If[HEFTPieceActiveQ[ "RQL20"], LEFT4FVecaux += Hold[LRQL20]];
If[HEFTPieceActiveQ[ "RQL21"], LEFT4FVecaux += Hold[LRQL21]];
If[HEFTPieceActiveQ[ "RQL22"], LEFT4FVecaux += Hold[LRQL22]];
If[HEFTPieceActiveQ[ "RQL23"], LEFT4FVecaux += Hold[LRQL23]];
If[HEFTPieceActiveQ[ "RQ9"], LEFT4FVecaux += Hold[LRQ9]];
If[HEFTPieceActiveQ[ "RQ10"], LEFT4FVecaux += Hold[LRQ10]];
If[HEFTPieceActiveQ[ "RQ11"], LEFT4FVecaux += Hold[LRQ11]];
If[HEFTPieceActiveQ[ "RQ12"], LEFT4FVecaux += Hold[LRQ12]];
If[HEFTPieceActiveQ[ "RQ13"], LEFT4FVecaux += Hold[LRQ13]];
If[HEFTPieceActiveQ[ "RQ14"], LEFT4FVecaux += Hold[LRQ14]];
If[HEFTPieceActiveQ[ "RQ15"], LEFT4FVecaux += Hold[LRQ15]];
If[HEFTPieceActiveQ[ "RQ16"], LEFT4FVecaux += Hold[LRQ16]];
If[HEFTPieceActiveQ[ "RQ17"], LEFT4FVecaux += Hold[LRQ17]];
If[HEFTPieceActiveQ[ "RQ18"], LEFT4FVecaux += Hold[LRQ18]];
If[HEFTPieceActiveQ[ "RQ19"], LEFT4FVecaux += Hold[LRQ19]];
If[HEFTPieceActiveQ[ "RQ20"], LEFT4FVecaux += Hold[LRQ20]];
If[HEFTPieceActiveQ[ "RQ21"], LEFT4FVecaux += Hold[LRQ21]];
If[HEFTPieceActiveQ[ "RQ22"], LEFT4FVecaux += Hold[LRQ22]];
If[HEFTPieceActiveQ[ "RQ23"], LEFT4FVecaux += Hold[LRQ23]];
If[HEFTPieceActiveQ[ "RQ24"], LEFT4FVecaux += Hold[LRQ24]];
If[HEFTPieceActiveQ[ "RQ25"], LEFT4FVecaux += Hold[LRQ25]];
If[HEFTPieceActiveQ[ "RQ26"], LEFT4FVecaux += Hold[LRQ26]];
If[HEFTPieceActiveQ[ "RL2"], LEFT4FVecaux += Hold[LRL2]];
If[HEFTPieceActiveQ[ "RL3"], LEFT4FVecaux += Hold[LRL3]];
If[HEFTPieceActiveQ[ "RL4"], LEFT4FVecaux += Hold[LRL4]];
If[HEFTPieceActiveQ[ "RL5"], LEFT4FVecaux += Hold[LRL5]];
If[HEFTPieceActiveQ[ "RL6"], LEFT4FVecaux += Hold[LRL6]];
If[HEFTPieceActiveQ[ "RL7"], LEFT4FVecaux += Hold[LRL7]];

(* Every four-fermion operator has chiral order 0 and carries WCOrder once.
   Each selected operator is added HELD and released only when LEFT4F is used, i.e. in the mass-basis
   step (HEFT_Model.fr), after the model has finished loading (2026-10-08, TESTS/T43), as LEFTBosonic
   since 2026-10-05.  Evaluated while this file loads, ExpandIndices[..., FlavorExpand -> {SU2D}] leaves
   an implicitly summed doublet index (LLbar[.., ii, ..].LL[.., ii, ..]) unexpanded, and HC of such a
   chain comes out with uncontracted spin indices (Ga[0, ...], TensDot[0, ...]): the whole h.c. half
   of RL2, RL4, RL6, RQ9, RQ10, RQ17, RQ18, RQ22, RQ23, RQL7, RQL9, RQL11, RQL14, RQL15, RQL18, RQL21
   was broken in every build between their + h.c. (2026-10-08) and this change. *)
LEFT4F := WCOrder*(4*Pi)^2/LamHEFT^2*ReleaseHold[LEFT4FChiraux + LEFT4FVecaux];
