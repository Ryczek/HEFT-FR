If[HEFTPieceActiveQ[ "RQL3"], LEFT4FChiraux += LRQL3];
If[HEFTPieceActiveQ[ "RQL4"], LEFT4FChiraux += LRQL4];
If[HEFTPieceActiveQ[ "RQL5"], LEFT4FChiraux += LRQL5];
If[HEFTPieceActiveQ[ "RQL6"], LEFT4FChiraux += LRQL6];
If[HEFTPieceActiveQ[ "RL1"], LEFT4FChiraux += LRL1];

LEFT4FVecaux = 0;
If[HEFTPieceActiveQ[ "RQL7"], LEFT4FVecaux += LRQL7];
If[HEFTPieceActiveQ[ "RQL8"], LEFT4FVecaux += LRQL8];
If[HEFTPieceActiveQ[ "RQL9"], LEFT4FVecaux += LRQL9];
If[HEFTPieceActiveQ[ "RQL10"], LEFT4FVecaux += LRQL10];
If[HEFTPieceActiveQ[ "RQL11"], LEFT4FVecaux += LRQL11];
If[HEFTPieceActiveQ[ "RQL12"], LEFT4FVecaux += LRQL12];
If[HEFTPieceActiveQ[ "RQL13"], LEFT4FVecaux += LRQL13];
If[HEFTPieceActiveQ[ "RQL14"], LEFT4FVecaux += LRQL14];
If[HEFTPieceActiveQ[ "RQL15"], LEFT4FVecaux += LRQL15];
If[HEFTPieceActiveQ[ "RQL16"], LEFT4FVecaux += LRQL16];
If[HEFTPieceActiveQ[ "RQL17"], LEFT4FVecaux += LRQL17];
If[HEFTPieceActiveQ[ "RQL18"], LEFT4FVecaux += LRQL18];
If[HEFTPieceActiveQ[ "RQL19"], LEFT4FVecaux += LRQL19];
If[HEFTPieceActiveQ[ "RQL20"], LEFT4FVecaux += LRQL20];
If[HEFTPieceActiveQ[ "RQL21"], LEFT4FVecaux += LRQL21];
If[HEFTPieceActiveQ[ "RQL22"], LEFT4FVecaux += LRQL22];
If[HEFTPieceActiveQ[ "RQL23"], LEFT4FVecaux += LRQL23];
If[HEFTPieceActiveQ[ "RQ9"], LEFT4FVecaux += LRQ9];
If[HEFTPieceActiveQ[ "RQ10"], LEFT4FVecaux += LRQ10];
If[HEFTPieceActiveQ[ "RQ11"], LEFT4FVecaux += LRQ11];
If[HEFTPieceActiveQ[ "RQ12"], LEFT4FVecaux += LRQ12];
If[HEFTPieceActiveQ[ "RQ13"], LEFT4FVecaux += LRQ13];
If[HEFTPieceActiveQ[ "RQ14"], LEFT4FVecaux += LRQ14];
If[HEFTPieceActiveQ[ "RQ15"], LEFT4FVecaux += LRQ15];
If[HEFTPieceActiveQ[ "RQ16"], LEFT4FVecaux += LRQ16];
If[HEFTPieceActiveQ[ "RQ17"], LEFT4FVecaux += LRQ17];
If[HEFTPieceActiveQ[ "RQ18"], LEFT4FVecaux += LRQ18];
If[HEFTPieceActiveQ[ "RQ19"], LEFT4FVecaux += LRQ19];
If[HEFTPieceActiveQ[ "RQ20"], LEFT4FVecaux += LRQ20];
If[HEFTPieceActiveQ[ "RQ21"], LEFT4FVecaux += LRQ21];
If[HEFTPieceActiveQ[ "RQ22"], LEFT4FVecaux += LRQ22];
If[HEFTPieceActiveQ[ "RQ23"], LEFT4FVecaux += LRQ23];
If[HEFTPieceActiveQ[ "RQ24"], LEFT4FVecaux += LRQ24];
If[HEFTPieceActiveQ[ "RQ25"], LEFT4FVecaux += LRQ25];
If[HEFTPieceActiveQ[ "RQ26"], LEFT4FVecaux += LRQ26];
If[HEFTPieceActiveQ[ "RL2"], LEFT4FVecaux += LRL2];
If[HEFTPieceActiveQ[ "RL3"], LEFT4FVecaux += LRL3];
If[HEFTPieceActiveQ[ "RL4"], LEFT4FVecaux += LRL4];
If[HEFTPieceActiveQ[ "RL5"], LEFT4FVecaux += LRL5];
If[HEFTPieceActiveQ[ "RL6"], LEFT4FVecaux += LRL6];
If[HEFTPieceActiveQ[ "RL7"], LEFT4FVecaux += LRL7];

(* Every four-fermion operator has chiral order 0 and carries WCOrder once. *)
LEFT4F := WCOrder*(4*Pi)^2/LamHEFT^2*(LEFT4FChiraux + LEFT4FVecaux);
