(* Common HEFT building blocks: U, VU, TT and their fermionic counterparts.

   UNITARY GAUGE ONLY.  The gauge is not a configuration option: the Goldstone-expanded ("rxi")
   branch that used to live here was removed 2026-09-18 on the user's decision to fix the model to
   unitary gauge, together with GoldstoneMaxOrder and the LamGold expansion parameter.  It was
   never finished - it had no *Ferm counterparts, so the whole fermionic sector referenced
   undefined symbols in that gauge and nothing errored.  Recoverable from git if it is ever picked
   up again.

   Lagrangian .fr files call FeynRules ExpandIndices[..., NoDefinitions -> True] directly when
   building operators (see README). That defers parameter Definitions until LHEFTMassBasis. *)

(* VU is the chiral covariant derivative in unitary gauge. (DU in 1611)
   Written in 1604.06801's +ig convention (V = (D U) U^dagger, D U = dU + i g W U - i g'/2 B U sigma3,
   paperV4.tex:287).  It is consistent with FeynRules' DC/FS only because HEFT_Model.fr sets
   FR$DSign = -1 (2026-09-23); with FeynRules' default +1 it would be -(D U) U^dagger. *)

U[] = IdentityMatrix[2];

VU[mu_] = Module[{ii},
  I*gw/2*Sum[PauliSigma[ii]*Wi[mu, ii], {ii, 1, 3}] -
  I*g1/2*PauliSigma[3]*B[mu]];

(* Custodial-breaking spurion T. *)

TT = PauliSigma[3];

PauliSigmaFerm[1, 1, 1] = 0;
PauliSigmaFerm[1, 1, 2] = 1;
PauliSigmaFerm[1, 2, 1] = 1;
PauliSigmaFerm[1, 2, 2] = 0;

PauliSigmaFerm[2, 1, 1] = 0;
PauliSigmaFerm[2, 1, 2] = -I;
PauliSigmaFerm[2, 2, 1] = I;
PauliSigmaFerm[2, 2, 2] = 0;

PauliSigmaFerm[3, 1, 1] = 1;
PauliSigmaFerm[3, 1, 2] = 0;
PauliSigmaFerm[3, 2, 1] = 0;
PauliSigmaFerm[3, 2, 2] = -1;

VUFerm[mu_, ii_, jj_] =
    I*gw/2*Sum[PauliSigmaFerm[k, ii, jj]*Wi[mu, k], {k, 1, 3}] -
    I*g1/2*B[mu]*PauliSigmaFerm[3, ii, jj];

TTFerm[jj_, kk_] = PauliSigmaFerm[3, jj, kk];

UFerm[ii_, jj_] = KroneckerDelta[ii, jj];

FSWi[mu_, nu_] := 1/2*Sum[PauliSigma[ii]*FS[Wi, mu, nu, ii], {ii, 1, 3}];

Sigma[mu_,nu_,sp1_,sp2_] := I/2 Module[{spx}, Ga[mu,sp1,spx] Ga[nu,spx,sp2] - Ga[nu,sp1,spx] Ga[mu,spx,sp2]];
