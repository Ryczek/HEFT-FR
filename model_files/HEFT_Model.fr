(* Modular HEFT model file (smeftfr-like, no use of the monolithic .fr). *)

HEFTModelRoot = DirectoryName[$InputFileName] // ExpandFileName;

HEFTLoad[rel_] := Get[FileNameJoin[{HEFTModelRoot, Sequence @@ rel}]];

(* COVARIANT-DERIVATIVE SIGN: D_mu = d_mu + i g A_mu, the convention of 1604.06801 (2026-09-23, user
   decision).  FeynRules' default is FR$DSign = 1, i.e. D = d - i g A, for DC and for the
   non-abelian part of FS; VU and VUFerm (definitions.fr) are hand-written in the paper's +ig form.
   With the default the two disagreed: VU = -(D_mu U) U^dagger for the fermions' D_mu, so every
   operator with an odd number of V's and field strengths had the opposite sign to the paper's
   (TESTS/FR_1604/CONVENTIONS.md 1).  With -1 everything is in the paper's convention and each
   operator is the paper's term by term.  SM physics is unchanged (the switch is the field
   redefinition A -> -A); vertices with n gauge legs change by (-1)^n.  FR$DSign is read when the
   Lagrangian is evaluated (DC, FS are delayed), so it only has to be set before that.  Which context
   it lives in depends on how FeynRules was loaded (FeynRules` through heft_fr.wl, Global` in a bare
   Get["FeynRules`"]); a bare or Global`-qualified assignment would create a second, unused symbol
   and silently leave FeynRules at +1 (it did, the first time - TESTS/FR_1604/C1prime).  So the
   value is set on whichever FR$DSign already exists, and the load aborts if FeynRules does not end
   up with -1.  Checked vertex by vertex: TESTS/FR_1604/C1prime. *)
HEFTDSignNames = Select[{"FeynRules`FR$DSign", "Global`FR$DSign"}, NameQ];
If[HEFTDSignNames === {}, Print["HEFT_Model.fr: FR$DSign not found - is FeynRules loaded?"]; Abort[]];
Scan[ToExpression[# <> " = -1"] &, HEFTDSignNames];
If[!AllTrue[HEFTDSignNames, ToExpression[#] === -1 &],
  Print["HEFT_Model.fr: could not set FR$DSign = -1 (", HEFTDSignNames, ")"]; Abort[]];

(* Configuration flags (Global` survives FeynRules model context during LoadModel). *)
If[ValueQ[Global`KappaFramework], KappaFramework = Global`KappaFramework];
If[!ValueQ[KappaFramework], KappaFramework = True];

(* CHIRAL ORDER IS BOOKKEEPING ONLY (2026-09-17, user decision).  Every EFT term carries
   ChiralOrder^n, n from its W/V/d/D count; nothing is truncated on it - it only labels vertices
   (UFO coupling order ChiralOrder), and the notebook Reference cell prints every operator with
   its chiral order.  The option MaxChiralOrder (before 2026-09-16 HEFTMaxOrder) was removed.

   SINGLE EFT INSERTION PER VERTEX - fixed, not an option (2026-09-17, user decision).  Every
   EFT term carries WCOrder exactly once; products of Wilson coefficients arise only through
   the A-Z normalisation (P1, P12; gauge_normalization.fr) and the gf/aem input shifts (P1, P12,
   PT, RL2, RL5; input_scheme.fr), and both are expanded to, and cut at, WCOrder^1 below.
   The options MaxEFTInsertions (before 2026-09-16 EFTMaxOrder), MaxChiralOrder and
   Combine2Derivatives were removed; heft_fr.wl refuses a Configuration that still sets them.
   README SS "Power counting and the single-insertion rule" lists what this drops. *)
If[ValueQ[Global`HiggsMaxOrder], NEFT = Global`HiggsMaxOrder];
If[!ValueQ[NEFT], NEFT = 3];
If[ValueQ[Global`HEFTWCxfOutputFile], HEFTWCxfOutputFile = Global`HEFTWCxfOutputFile];
If[ValueQ[Global`HEFTWCxfFile], HEFTWCxfOutputFile = Global`HEFTWCxfFile];

(* heft_fr.wl may set Global`LamHEFT; never leave LamHEFT bound to a number here. *)
If[ValueQ[LamHEFT] && NumericQ[LamHEFT], Remove[LamHEFT]];

(* Fields and SM pieces *)
HEFTLoad[{"fields.fr"}];
(* Building blocks (U, VU, FSWi, TT, ...) - unitary gauge, the only one implemented *)
HEFTLoad[{"definitions.fr"}];
HEFTLoad[{"wcxf_input.fr"}];
HEFTInitializeWCxf[];

HEFTLoad[{"parameters", "parameters_SM.fr"}];
(* DownValues[f] =!= {}, not ValueQ[f]: these are all defined as f[] := ..., and ValueQ only
   looks at OwnValues, so ValueQ[f] is False for every one of them.  Written as ValueQ, all six
   of these guards below were permanently false - the Wilson-coefficient values read from
   wcxf_output.json were loaded into HEFTWCValues but never written into M$Parameters, so every
   UFO / FeynArts export shipped the .fr defaults (all 1) no matter what the JSON said.
   (Operator selection was unaffected: HEFTPieceActiveQ reads HEFTWCValues directly.) *)
If[DownValues[HEFTWCApplyScaleParameter] =!= {}, HEFTWCApplyScaleParameter[]];
If[DownValues[HEFTWCApplyLOParameters] =!= {}, HEFTWCApplyLOParameters[]];
HEFTLoad[{"Lagrangian", "Lagrangian_SM.fr"}];

(* Power-counting parameters (ChiralOrder, WCOrder, LamF); LamHEFT in parameters_SM.fr *)
HEFTLoad[{"power_counting.fr"}];

(* NLO parameters and Lagrangians *)

(* The operator basis is Brivio et al. 1604.06801, hard-coded: it is not a configuration
   option (the HEFTNLOBasis switch and its validation were removed 2026-09-18, as was the
   never-implemented 2206.07722 alternative). *)

(* HEFTFlareSpecCheck[] - load-time consistency of every flare spec (2026-09-17).  Aborts when
     1. a flare that appears under a derivative in its operator, del[FC<op>[...], mu], starts at
        n = 0 - the constant term drops out, so nmin must be 1 (it used to be declared anyway,
        an unused Wilson coefficient; nine bosonic and twelve fermionic operators had it);
     2. an operator's Lagrangian L<op> contains more than one flare function - two Wilson-
        coefficient families multiplied in one term break the single-insertion rule; write it
        with one combined flare (combinedDerivFlareSpecs / ferm2FCombinedFlareSpecs);
     3. the WCxf key tables (wcxf_input.fr) disagree with a flare spec on prefix or nmin - the
        generated key would name a coefficient the model does not have, or miss one it has.
   Reads the unevaluated definitions (OwnValues of L<op>), so it costs nothing and does not
   depend on which operators are selected.  The user-defined rows (parameters_User.fr) are in
   scalarFlareSpecs by the time this runs, so they are checked too. *)
HEFTFlareSpecCheck::derivnmin =
  "Operator `1`: its flare `2` appears under a derivative in L`1` but starts at n = 0. A flare \
inside a derivative must start at n = 1 (its constant term drops out) - set nmin = 1 in its spec \
row and in wcxf_input.fr. Aborting.";
HEFTFlareSpecCheck::twoflares =
  "Operator `1`: L`1` contains more than one flare function, `2`. Two Wilson-coefficient families \
in one term break the single-insertion rule - use one combined flare (see combinedDerivFlareSpecs / \
ferm2FCombinedFlareSpecs in parameters_EFT.fr). Aborting.";
HEFTFlareSpecCheck::wcxf =
  "Operator `1`: the flare spec has prefix `2` starting at `3`, but wcxf_input.fr generates `4`. \
Keep the WCxf key table in step with the flare spec. Aborting.";
HEFTFlareSpecCheck[] := Module[{ownValuesOf, flareHeads, checkSpec, scalarRows, combinedRows},
  ownValuesOf[op_String] := Quiet @ ToExpression["L" <> op, InputForm, OwnValues];
  flareHeads[ov_] := Union @ Cases[ov, (f_Symbol /; StringStartsQ[SymbolName[f], "FC"])[___] :> f,
    {0, Infinity}, Heads -> True];
  (* {flare, op, prefix, nmin} and the first key the WCxf tables produce for that op *)
  checkSpec[{fn_, op_String, prefix_String, nmin_Integer}, firstKey_, expectedKey_String] :=
    Module[{ov = ownValuesOf[op], heads},
      If[ov =!= {},
        If[nmin === 0 && !FreeQ[ov, del[fn[___], _]],
          Message[HEFTFlareSpecCheck::derivnmin, op, fn]; Abort[]];
        heads = flareHeads[ov];
        If[Length[heads] > 1, Message[HEFTFlareSpecCheck::twoflares, op, heads]; Abort[]]
      ];
      If[firstKey =!= None && firstKey =!= expectedKey,
        Message[HEFTFlareSpecCheck::wcxf, op, prefix, nmin, firstKey]; Abort[]]
    ];
  scalarRows = Association[(#[[1]] -> #) & /@ HEFT1604ScalarOpPrefixes];
  combinedRows = Association[(#[[1]] -> #) & /@ heft1604CombinedDerivOpPrefixes];
  Scan[checkSpec[#, Lookup[scalarRows, #[[2]], {None, "missing", -1}] /.
      {o_, pre_String, k_Integer} :> pre <> ToString[k], #[[3]] <> ToString[#[[4]]]] &, scalarFlareSpecs];
  Scan[checkSpec[{#[[1]], #[[2]], #[[3]], 1}, Lookup[combinedRows, #[[2]], {None, "missing", -1}] /.
      {o_, pre_String, k_Integer} :> pre <> ToString[k], #[[3]] <> ToString[#[[4]]]] &, combinedDerivFlareSpecs];
  Scan[checkSpec[#, First[HEFTWCGen2FermKeys[#[[2]]], None], #[[3]] <> ToString[#[[4]]] <>
      If[MemberQ[HEFT1604Fermion2FOffDiagOps, #[[2]]], "_1_2", "_1_1"]] &,  (* NL15-NL17: no diagonal keys *)
    ferm2FFlareSpecs];
  Scan[checkSpec[{#[[1]], #[[2]], #[[3]], 1}, First[HEFTWCGen2FermKeys[#[[2]]], None],
      #[[3]] <> ToString[#[[4]]] <> "prime_1_1"] &, ferm2FCombinedFlareSpecs];
  Scan[checkSpec[#, First[HEFTWCGen4FermKeys[#[[2]]], None], #[[3]] <> ToString[#[[4]]] <> "_1_1_1_1"] &,
    ferm4FFlareSpecs];
  True
];

(* HEFTWCKeySetCheck[] - the full WCxf key set against the declared coefficient entries (2026-10-13,
   TODO.md plan 1.5).  HEFTFlareSpecCheck compares only the FIRST key of each operator with its spec;
   this compares, for every selected operator, the whole set of keys wcxf_input.fr generates
   (HEFTWCOperatorKeys) with the whole set of entries the coefficient tables of parameters_EFT*.fr /
   parameters_User.fr declare (one per scalar, one per declared flavour tuple of a tensor).  A key
   without an entry would be a value the model silently ignores; an entry without a key, a coefficient
   the WCxf file cannot set.  Catches power ranges, flavour tuples and the off-diagonal-only tensors
   (HEFT1604Fermion2FOffDiagOps).  Runs after the specs and the active-operator list are final. *)
HEFTFlareSpecCheck::keyset =
  "Operator `1`: the WCxf keys (wcxf_input.fr) and the declared coefficient entries (parameters files) \
differ - `2` key(s) with no declared entry, e.g. `3`; `4` declared entr(y/ies) with no key, e.g. `5`. \
Keep the two in step. Aborting.";
HEFTWCKeySetCheck[] := Module[{entryKeys, tablesOf, bad = 0},
  entryKeys[Equal[sym_Symbol, opts_List]] := With[{idx = Indices /. opts, val = Value /. opts},
    If[idx === Indices, {SymbolName[sym]},
      Cases[Flatten[{val}], (Rule | RuleDelayed)[s_Symbol[i__Integer], _] :> HEFTWCFlatKey[s, i]]]];
  entryKeys[_] := {};
  tablesOf[op_String] := Flatten @ Join[
    (MakeScalarCoeffTable @@ #) & /@ Select[scalarCoeffSpecs, First[#] === op &],
    (MakeCombinedCoeffTable @@ #) & /@ Select[combinedDerivCoeffSpecs, First[#] === op &],
    (MakeFermCoeffTable[#[[1]], #[[2]], #[[3]], 2] &) /@ Select[ferm2FCoeffSpecs, First[#] === op &],
    (MakeFermCombinedCoeffTable @@ #) & /@ Select[ferm2FCombinedCoeffSpecs, First[#] === op &],
    (MakeFermCoeffTable[#[[1]], #[[2]], #[[3]], 4] &) /@ Select[ferm4FCoeffSpecs, First[#] === op &]];
  Scan[Function[op, Module[{declared, keys, noEntry, noKey},
      declared = Union @ Flatten[entryKeys /@ tablesOf[op]];
      keys = Union @ HEFTWCOperatorKeys[op];
      noEntry = Complement[keys, declared]; noKey = Complement[declared, keys];
      If[noEntry =!= {} || noKey =!= {},
        Message[HEFTFlareSpecCheck::keyset, op, Length[noEntry], Take[noEntry, UpTo[3]],
          Length[noKey], Take[noKey, UpTo[3]]]; bad++]]],
    HEFTActiveEFTPieces];
  If[bad > 0, Abort[]];
  True
];

Module[{},
  (* heft_fr.wl sets Global`HEFTActiveEFTPieces; mirror before any EFT .fr file runs. *)
  If[ValueQ[Global`HEFTActiveEFTPieces],
    HEFTActiveEFTPieces = Global`HEFTActiveEFTPieces
  ];
  If[!ValueQ[HEFTActiveEFTPieces], HEFTActiveEFTPieces = {}];

  HEFTLoad[{"parameters", "parameters_EFT.fr"}];
  HEFTLoad[{"Lagrangian", "Lagrangian_EFT_Bosonic.fr"}];

  (* User-defined operators (shipped with the gluon-Higgs NNLO operators as the example): an
     extension beyond the 1604.06801 NLO basis rather than part of that paper.  Loaded
     unconditionally - which operators actually enter is decided by HEFTPieceActiveQ alone
     (ChiralOrder is only a label; WCOrder is always cut at 1).  parameters_User must come after
     parameters_EFT: it appends to that file's spec lists. *)
  HEFTLoad[{"parameters", "parameters_User.fr"}];
  HEFTLoad[{"Lagrangian", "Lagrangian_User.fr"}];

  HEFTLoad[{"Lagrangian", "Lagrangian_EFT_2F.fr"}];
  HEFTLoad[{"Lagrangian", "Lagrangian_EFT_4F.fr"}];

  (* Flare specs against the Lagrangians and the WCxf key tables - see HEFTFlareSpecCheck below. *)
  HEFTFlareSpecCheck[];

  (* Re-register Wilson coeffs and refresh gated form factors. *)
  If[DownValues[HEFTRegisterNLOWilsonCoefficients] =!= {},
    HEFTRegisterNLOWilsonCoefficients[]
  ];
  (* Every selected operator: full WCxf key set = declared coefficient entries (2026-10-13). *)
  HEFTWCKeySetCheck[];
  If[DownValues[HEFTWCApplyNLOParameters] =!= {}, HEFTWCApplyNLOParameters[]];
  If[DownValues[HEFTWCPrintApplySummary] =!= {}, HEFTWCPrintApplySummary[]];
  (* Re-assemble LUser using the configured operator list (context-safe).  Delayed (:=, since
     2026-10-05, TESTS/T39): the user operators are evaluated when LUser is used in the mass-basis
     step, after the model has loaded.  Evaluated here, during the load, they came out
     unexpanded, and PGHD2/PWHD2 (a squared non-abelian field strength) then got a wrong quartic
     gauge part - see the comment at LEFTBosonic in Lagrangian_EFT_Bosonic.fr. *)
  If[DownValues[HEFTRebuildLUser] =!= {}, LUser := HEFTRebuildLUser[]];
];

(* A–Z mixing matrix (AZnorm). *)
HEFTLoad[{"gauge_normalization.fr"}];
HEFTUpdateGaugeNormalizations[];

(* EW input replacements (EWInputScheme from the notebook Configuration or defaults).  The CKM
   side is no longer selectable: DiagonalCKM alone decides whether CKM -> IndexDelta. *)
HEFTLoad[{"input_scheme.fr"}];

(* Assemble full Lagrangian from SM + selected EFT pieces.  Unitary gauge throughout: there is
   no Goldstone sector and nothing to expand. *)

(* Lagrangian in the electroweak (gauge) basis, before chiral-dimension truncation.
   Gauge normalizations are updated first so that AZnorm
   is well-defined when the SM and EFT pieces are assembled. *)

(* Raw mass-basis Lagrangian, before the EW input-scheme replacement
   (HEFTEWInputRepl is applied afterwards, at the end of this file). *)
HEFTLHEFTMassBasisRaw :=
  Module[{lag,nn},

    (* Use only the pieces that were actually defined in the NLO Lagrangian. *)
    lag = LSM + LEFTBosonic + LUser + LEFT2F + LEFT4F;

    (* Go to the mass basis by applying all field and parameter
       Definitions (A/Z mixing, etc.). *)

    (*lag = lag /. KinRepl;*)


    If[ValueQ[HEFTCKMInputRepl] && HEFTCKMInputRepl =!= {},
      lag = lag /. HEFTCKMInputRepl
    ];

    (* Mass / physical basis: apply deferred field and parameter Definitions
       (Wi -> W/Z/A, B/Gl -> physical, AZnorm, gw/g1/gs, ...).
       Without this, WriteUFO sees mixed {W, Wi, ...} and raises QN::NonConserv. *)
  

    lag = ExpandIndices[lag, FlavorExpand -> {SU2W,SU2D}];

     (* Truncate at a single EFT insertion.  ChiralOrder is not truncated: it is a label. *)
    lag = lag /. WCOrder^nn_Integer /; nn > 1 -> 0;

    lag = lag /. powercountingreplacements;

    lag
  ];

(* Re-expand in WCOrder, then truncate at a single insertion.

   Needed after the EW input-scheme replacement.  The "gf"/"aem" rules carry WCOrder into vev,
   GW, G1 and hlambda, and those appear in DENOMINATORS in the Lagrangian (1/vev,
   (LamF h/vev)^n, ...).  A plain /. therefore leaves 1/(a + b WCOrder) behind - an
   uncontrolled all-orders resummation - and it also reintroduces powers above the cut through
   cross terms between two replaced symbols.  The truncation inside HEFTLHEFTMassBasisRaw runs
   BEFORE the substitution, so nothing cleans this up.  Expanding about WCOrder = 0 turns the
   denominators back into polynomials.  (Until 2026-09-15 the expansion was in ChiralOrder,
   which then carried the P1/P12/PT shifts; until 2026-09-17 this function also cut ChiralOrder
   at MaxChiralOrder.  ChiralOrder is now a label only and rides along untouched.)

   Series is mapped over the top-level Plus instead of being applied to the whole
   Lagrangian at once: one SeriesData per term is far cheaper in time and memory than a
   single huge one, and the result is identical.  The fields/Dot products do not depend on
   WCOrder, so they ride along as constants. *)
HEFTTruncateOrders[expr_, maxEFT_Integer] :=
  Module[{eps, work, seriesOf},
    If[FreeQ[expr, WCOrder], Return[expr]];
    seriesOf[t_] := Normal @ Series[t, {eps, 0, maxEFT}];
    work = expr /. WCOrder -> eps;
    work = If[Head[work] === Plus,
      Plus @@ (seriesOf /@ (List @@ work)),
      seriesOf[work]
    ];
    (* Cross terms between two expanded factors can still exceed the cut after Expand. *)
    work = Expand[work] /. eps^nn_Integer /; nn > maxEFT -> 0;
    work /. eps -> WCOrder
  ];

(* EW input-scheme replacement is applied last, outside the Module, so
   LHEFTMassBasis stays a lazy rule (cacheable via lheft_cache.wl) and
   HEFTEWInputRepl (built in input_scheme.fr) can add WCOrder-dependent
   shifts (the "gf"/"aem" linear corrections) without interfering with
   the truncations above - the re-truncation below is what puts
   those shifts back on the same footing as the rest of the Lagrangian. *)
LHEFTMassBasis :=
  If[ValueQ[HEFTEWInputRepl] && HEFTEWInputRepl =!= {},
    HEFTTruncateOrders[HEFTLHEFTMassBasisRaw /. HEFTEWInputRepl, 1],
    HEFTLHEFTMassBasisRaw
  ];